# === Обовʼязково ===

# Токен бота від @BotFather
BOT_TOKEN=1234567890:AAF...

# Для самохостнутого Bot API сервера (файли до 2 ГБ, docker-compose).
# Отримати: https://my.telegram.org → API development tools (2 хвилини).
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# === Необовʼязково ===

# Cookies для Instagram / приватних постів. Можна кілька профілів через кому —
# бот ротуватиме їх і перемикатиметься при відмовах авторизації.
# COOKIES_FILE=cookies.txt
# COOKIES_FILE=cookies1.txt,cookies2.txt

# Telegram ID адмінів (через кому) — доступ до /stats
# ADMIN_IDS=123456789

# Webhook замість polling (потрібен публічний HTTPS-URL до цього сервера)
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_PORT=8080

# Максимальний розмір файлу в МБ.
# За замовчуванням: 1950 з локальним Bot API, 49 — з хмарним.
# MAX_FILE_MB=1950

# Одночасних завантажень (за замовчуванням 4)
# MAX_CONCURRENT_DOWNLOADS=4

# Задаються автоматично в docker-compose; для запуску без Docker:
# BOT_API_URL=http://localhost:8081
# REDIS_URL=redis://localhost:6379/0
